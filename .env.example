# =============================================================
# Variables de entorno para correr el pipeline en local.
# Cópialo a .env.local (ignorado por git) y rellena los valores.
# En GitHub Actions van como Secrets del repo con el mismo nombre.
# =============================================================

# Apify — token de la cuenta de Datalítica
APIFY_TOKEN=apify_api_...

# Supabase — proyecto de SendWave (Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role JWT>

# Gemini — clasificación de contenido y hallazgos (opcional: sin ella se usa el clasificador por palabras clave)
GEMINI_API_KEY=
